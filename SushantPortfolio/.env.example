# PostgreSQL Neon
POSTGRES_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require
POSTGRES_HOST=host.neon.tech
PGDATABASE=dbname
POSTGRES_DATABASE=dbname
POSTGRES_PASSWORD=password
POSTGRES_URL_NO_SSL=postgres://user:password@host.neon.tech/dbname

# Vercel Blob Storage
BLOB_STORE_ID=your_store_id
BLOB_READ_WRITE_TOKEN=your_token
BLOB_WEBHOOK_PUBLIC_KEY=your_webhook_key

# Admin Credentials (local development only)
ADMIN_USER=admin
ADMIN_PASS=your_secure_password
ADMIN_SECRET=generate_with_crypto.randomBytes(32).toString("hex")

# Environment
PORT=3000
